##发送端函数（每台机器都装）
##把下面函数放进 ~/.bashrc（或 .zshrc）：
# 发送消息到某台机器
# 用法: send cc 我到公司了
send() {
    [ $# -lt 2 ] && echo "用法: send <cc|ll> <消息>" && return 1
    local target="$1"
    shift
    local from
    from=$(hostname -s)
    ssh "$target" "echo '[$(date "+%F %T")][$from] $*' >> ~/chan1"
}


# 用法: recv
recv() {
    [ ! -f ~/chan1 ] && touch ~/chan1 && chmod 666 ~/chan1

    tail -f ~/chan1 | while read -r line; do
        # 找当前用户所有 tty
        local ttys
        ttys=$(who | awk -v u="$USER" '$1==u {print $2}')

        if [ -n "$ttys" ]; then
            # 写进每个 tty（write 一次只能一个）
            while read -r tty; do
                echo "$line" | write "$USER" "$tty" 2>/dev/null
            done <<< "$ttys"
        else
            # 没有 tty 就直接打印（比如纯 ssh 命令环境）
            echo "$line"
        fi
    done
}


